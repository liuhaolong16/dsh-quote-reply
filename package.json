{
  "name": "dsh-quote-reply",
  "version": "0.9.0",
  "description": "Quote reply layer for DeepSeek Harness: quote a passage into an editable tray above the composer; it rides into the next turn as model context (never into the message body) and appears as an expandable 引用(N) row under that turn. Includes localStorage persistence and a host/client version handshake. 引用回复层：选中一段进输入框上方的引用行，随下一回合作为上下文注入模型（不进消息正文），并在回合尾部显示可展开的 引用(N)；含落盘与宿主/客户端版本握手。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "quote",
    "reply",
    "conversation",
    "ux"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/liuhaolong16/dsh-quote-reply.git"
  },
  "homepage": "https://github.com/liuhaolong16/dsh-quote-reply#readme",
  "bugs": {
    "url": "https://github.com/liuhaolong16/dsh-quote-reply/issues"
  }
}
